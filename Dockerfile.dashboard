FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /workspace
COPY analysis/requirements.txt analysis/requirements.txt
RUN pip install --no-cache-dir -r analysis/requirements.txt
COPY analysis/ analysis/
COPY experiments/results/baseline.csv experiments/results/baseline.csv

EXPOSE 8501
CMD ["python", "-m", "streamlit", "run", "analysis/dashboard.py", "--server.address=0.0.0.0", "--server.port=8501"]
